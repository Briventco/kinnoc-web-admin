# Copy to .env.local and fill in. Every VITE_* value is bundled into the browser
# app and readable by anyone who opens it, so only PUBLIC configuration belongs here.
# Never add the Supabase service-role key, database URLs or other server secrets.

# Kinnoc API, including the /api/v1 prefix.
VITE_API_BASE_URL=https://kinnoc-api.onrender.com/api/v1

# Supabase project used by the Kinnoc API (Project Settings -> API).
# The URL looks like https://<project-ref>.supabase.co.
VITE_SUPABASE_URL=
# The public anon key (legacy JWT) or the sb_publishable_... key. NOT the service-role key.
VITE_SUPABASE_ANON_KEY=

# Storage bucket for event posters and organizer logos. Must match the API's
# SUPABASE_EVENT_MEDIA_BUCKET (default: event-media).
VITE_SUPABASE_EVENT_MEDIA_BUCKET=event-media
