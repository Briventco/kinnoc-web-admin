# Copy to .env.local and fill in. Every VITE_* value is bundled into the browser
# app and readable by anyone who opens it, so only PUBLIC configuration belongs here.
# Never add the Supabase service-role key (sb_secret_...), database URLs, JWT
# secrets or passwords.

# --- Production -------------------------------------------------------------
# Kinnoc API, including the /api/v1 prefix.
VITE_API_BASE_URL=https://kinnoc-api.onrender.com/api/v1

# The Supabase project the API trusts. Production project: dswtmdossvubkzrkabjx.
VITE_SUPABASE_URL=https://dswtmdossvubkzrkabjx.supabase.co
# That project's publishable key (sb_publishable_...) or legacy anon JWT, from
# Supabase dashboard -> Project Settings -> API Keys. NOT the secret/service-role key.
VITE_SUPABASE_ANON_KEY=

# Storage bucket for event posters and logos. Must match the API's
# SUPABASE_EVENT_MEDIA_BUCKET (default: event-media).
VITE_SUPABASE_EVENT_MEDIA_BUCKET=event-media

# --- Local development against the production API ---------------------------
# The production API only allows https CORS origins, so http://localhost can't
# call it directly. For `npm run dev`, put these two lines in .env.development.local
# (dev-only overrides) so requests go through the Vite dev server's proxy:
# VITE_API_BASE_URL=/api/v1
# VITE_DEV_API_PROXY=https://kinnoc-api.onrender.com
